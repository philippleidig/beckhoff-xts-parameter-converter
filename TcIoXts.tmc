          <Name>ModuleType</Name>
          <Comment><![CDATA[Returns type of module.]]></Comment>
          <BaseType GUID="{6ee1cfe8-678c-4b55-b5aa-7576217847c6}">ModuleType</BaseType>
          <PTCID>#x03080308</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Module Type Info">
          <Name>Angle</Name>
          <Comment><![CDATA[Returns the angle of the module in deg.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00000000000e}">LREAL</BaseType>
          <Unit>°</Unit>
          <PTCID>#x00000083</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Module Type Info">
          <Name>Length</Name>
          <Comment><![CDATA[Returns the length of the module in mm. The length is measured along the center of the coils.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00000000000e}">LREAL</BaseType>
          <Unit>mm</Unit>
          <PTCID>#x00000082</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="EtherCAT Master">
          <Name>MasterNetId</Name>
