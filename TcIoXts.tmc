            <LBound>0</LBound>
            <Elements Max="25" Min="1">1</Elements>
          </ArrayInfo>
          <PTCID>#x03080606</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="State Machine">
          <Name>DriveControlValue</Name>
          <Comment><![CDATA[Gets the control value of the drive.]]></Comment>
