          <PTCID>#x030802A1</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - General">
          <Name>DriveHardwareVersion</Name>
          <Comment><![CDATA[Returns the hardware version of the module.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00010000000f}">STRING(15)</BaseType>
          <PTCID>#x030802A2</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - General">
          <Name>DriveSoftwareVersion</Name>
          <Comment><![CDATA[Returns the software version of the module.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00010000000f}">STRING(15)</BaseType>
          <PTCID>#x030802A3</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - General">
