          <PTCID>#x0308060B</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Drive CoE - Diag History">
          <Name>TriggerAcknowledgeMessages</Name>
          <Comment><![CDATA[If downloaded then all known diagnostics messages will be acknowledged.]]></Comment>
          <PTCID>#x03080607</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - Diag History">
          <Name>UnacknowledgedMessageCount</Name>
