          <ContextId>1</ContextId>
        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="State Machine">
          <Name>DriveState</Name>
          <Comment><![CDATA[Gets the state of the drive system.]]></Comment>
          <BaseType GUID="{c3adb195-ddf2-437f-af8e-fb07c2f42281}">DriveState</BaseType>
          <PTCID>#x000000A0</PTCID>
