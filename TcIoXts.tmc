          <PTCID>#x0308020B</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - General">
          <Name>DriveDeviceType</Name>
          <Comment><![CDATA[Returns the type of the corresponding module.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
          <PTCID>#x030802A0</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - General">
