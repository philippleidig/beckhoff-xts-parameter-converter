          <Default>
            <EnumText>FALSE</EnumText>
          </Default>
          <PTCID>#x030805A1</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover Id Detection">
          <Name>IdDetectionMode</Name>
          <Comment><![CDATA[Choose the ID detection mode to enable Mover 1 detection. Standard means that mover ID detection is off.]]></Comment>
          <BaseType GUID="{4f52cf49-afc6-4217-9ae7-edeb2119d7c5}">MoverIdDetectionMode</BaseType>
          <Default>
            <EnumText>Standard</EnumText>
