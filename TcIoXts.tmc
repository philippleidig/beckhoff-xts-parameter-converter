          <PTCID>#x00000064</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="EtherCAT Slave">
          <Name>EncoderOnlineIdentity</Name>
          <Comment><![CDATA[Gets a structure of the online Encoder identity containing the vendor id, the code, the revision and the serial number.]]></Comment>
          <BaseType GUID="{1ec63745-8dee-41e3-a93d-ce6d14350001}">ProductIdentity</BaseType>
