        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="EtherCAT Slave">
          <Name>IsInOp</Name>
          <Comment><![CDATA[Returns true when all EtherCAT slaves are in Op state.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
          <PTCID>#x030805C3</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="EtherCAT Slave">
          <Name>IsSlaveCommunicationInterrupted</Name>
