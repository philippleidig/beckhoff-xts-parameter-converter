          <PTCID>#x030802AF</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - Amplifier Settings">
          <Name>MinDcLinkVoltage</Name>
          <Comment><![CDATA[Returns the minimal DC link voltage which should be considered valid.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          <Unit>V</Unit>
          <PTCID>#x030802C3</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - Amplifier Settings">
          <Name>MaxDcLinkVoltage</Name>
          <Comment><![CDATA[Returns the maximal DC link voltage which should be considered valid.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          <Unit>V</Unit>
          <PTCID>#x030802C4</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - Amplifier Settings">
          <Name>I2TWarnLevel</Name>
          <Comment><![CDATA[Returns the I2T level which results in a warning if the current value exceeds this level.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-000000000002}">USINT</BaseType>
          <Unit>%</Unit>
          <PTCID>#x030802C5</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - Amplifier Settings">
          <Name>I2TErrorLevel</Name>
          <Comment><![CDATA[Returns the I2T level which results in an error if the current value exceeds this level.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-000000000002}">USINT</BaseType>
          <Unit>%</Unit>
          <PTCID>#x030802C6</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - Amplifier Settings">
          <Name>TemperatureWarnLevel</Name>
