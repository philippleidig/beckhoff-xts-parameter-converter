          <ContextId>1</ContextId>
          <DependOn DownloadAnyway="true">
            <PTCID>#x03080246</PTCID>
            <Equals>
              <EnumText>Mover1</EnumText>
            </Equals>
            <Equals>
              <EnumText>MultipleMover1</EnumText>
            </Equals>
          </DependOn>
        </Parameter>
        <Parameter HideParameter="true" Group="Mover Id Detection">
          <Name>DelayBetweenMoverPacks</Name>
          <Comment><![CDATA[Time delay [s] between triggering movers simultaneously which are not in the same mover pack.]]></Comment>
