        <Parameter HideParameter="true" Group="Info">
          <Name>AdsPort</Name>
          <Comment><![CDATA[Gets/sets the ads port. The port should be used to read/write parameters via ADS.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-000000000004}">WORD</BaseType>
          <Default>
            <Value>0</Value>
          </Default>
          <PTCID>#x03002090</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" Group="Info">
          <Name>TaskOID</Name>
          <Comment><![CDATA[Gets/Sets the XTS Task that is used for calculations for the XtsProcessingUnit.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00000000000f}">OTCID</BaseType>
          <Default>
            <Value>#x00000000</Value>
          </Default>
          <PTCID>#x03002060</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="General">
          <Name>OperationMode</Name>
          <Comment><![CDATA[Choose between 'Normal' to work with actual hardware and 'Simulation' to work in simulation.]]></Comment>
          <BaseType GUID="{c929b002-bf94-48a2-937b-5d20ded8ef3b}">OperationMode</BaseType>
          <Default>
            <EnumText>Normal</EnumText>
          </Default>
          <PTCID>#x0308022C</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover">
          <Name>MoverType</Name>
          <Comment><![CDATA[Choose the appropriate mover type. Use custom for a non Beckhoff mover.]]></Comment>
          <BaseType GUID="{a69dd36a-7294-45ab-8104-2f1b69cd0767}">MoverType</BaseType>
          <Default>
            <EnumText>AT9014_0055</EnumText>
          </Default>
          <PTCID>#x00000090</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover">
          <Name>MagnetPlateType</Name>
          <Comment><![CDATA[Attention! Choose the correct magnet plate type. If not correct the mover can jump unexpectedly.]]></Comment>
          <BaseType GUID="{66c1e2f8-6843-4170-a4a0-f7664f017358}">MagnetPlateType</BaseType>
          <Default>
            <EnumText>AT9001_0550</EnumText>
          </Default>
          <PTCID>#x00000091</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover">
          <Name>MoverSortOrder</Name>
          <Comment><![CDATA[Choose the sort order of the movers. Standard is ascending which means that the first mover gets the lowest position.]]></Comment>
          <BaseType GUID="{462418ce-e154-4085-a5cd-380418ddca78}">SortOrderEnum</BaseType>
          <Default>
            <EnumText>Descending</EnumText>
          </Default>
          <PTCID>#x00000048</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover">
          <Name>MinMechanicalMoverDistance</Name>
          <Comment><![CDATA[Gets/sets the minimum position distance between the movers, which has to be measured in the curve. As a default the distance belonging to the mover type is used.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00000000000e}">LREAL</BaseType>
          <Unit>mm</Unit>
          <Default>
            <Min>0.0</Min>
            <Value>0.0</Value>
          </Default>
          <PTCID>#x0308027A</PTCID>
          <ContextId>1</ContextId>
          <DependOn DownloadAnyway="true">
            <PTCID>#x00000090</PTCID>
            <Equals>
              <EnumText>UserSpecific</EnumText>
            </Equals>
          </DependOn>
        </Parameter>
        <Parameter Group="Commands">
          <Name>TriggerResetAllParts</Name>
          <Comment><![CDATA[If downloaded then all faulty modules will be resetted.]]></Comment>
          <PTCID>#x030802EB</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover Detection">
          <Name>ConfiguredDetectionCount</Name>
          <Comment><![CDATA[Gets/sets the number of movers to be detected.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
          <Default>
            <Value>0</Value>
          </Default>
          <PTCID>#x030802B4</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" Group="Mover Detection">
          <Name>ConfiguredRetryCount</Name>
          <Comment><![CDATA[Gets/sets the number of retries which are performed for a triggered detection if not the expected number of movers are detected.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
          <Default>
            <Value>0</Value>
          </Default>
          <PTCID>#x030802F1</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover Detection">
          <Name>TriggerDetection</Name>
          <Comment><![CDATA[If downloaded then a new detection is started to search for the configured count of new movers on all included tracks.]]></Comment>
          <PTCID>#x030802B5</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover Detection">
          <Name>TriggerRedetection</Name>
          <Comment><![CDATA[If downloaded then all movers will loose their position and a new detection is performed. The order of movers might change.]]></Comment>
          <PTCID>#x00000098</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter Group="Mover Detection">
          <Name>IsDetectionAfterStartupDisabled</Name>
