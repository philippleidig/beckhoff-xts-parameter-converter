          <PTCID>#x03080577</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter CreateSymbol="true" ReadOnly="true" OnlineParameter="true" Group="EtherCAT Slave">
          <Name>EncoderEtherCatSlaveStateInfo</Name>
