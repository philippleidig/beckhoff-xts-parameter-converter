            <PTCID>#x03080246</PTCID>
            <Equals>
              <EnumText>Mover1</EnumText>
            </Equals>
          </DependOn>
        </Parameter>
        <Parameter HideParameter="true" Group="Mover Id Detection">
          <Name>DelayBetweenMoversInPack</Name>
          <Comment><![CDATA[Time delay [s] between triggering movers which are directly next to each other within the MoverPackGap.]]></Comment>
          <BaseType GUID="{18071995-0000-0000-0000-00000000000e}">LREAL</BaseType>
          <Unit>s</Unit>
          <Default>
            <Min>0.001</Min>
            <Max>10.0</Max>
            <Value>0.01</Value>
