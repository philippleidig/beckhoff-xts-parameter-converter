      <BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
      <EnumInfo>
        <Text>Off</Text>
        <Enum>0</Enum>
        <Comment>Tuning process is off and not used.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>Error</Text>
        <Enum>1</Enum>
        <Comment>Error in the tuning process.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>StartMeasure</Text>
        <Enum>2</Enum>
        <Comment>Start of measurement is requested.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>Measure</Text>
        <Enum>3</Enum>
        <Comment>Active measurement step of the tuning process.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>MeasureDone</Text>
        <Enum>4</Enum>
        <Comment>Measurement tuning process step is positive done.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>SpectrumCalculation1</Text>
        <Enum>5</Enum>
        <Comment>First calculation step of the spectrum is in progress.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>SpectrumCalculation2</Text>
        <Enum>6</Enum>
        <Comment>Second calculation step of the spectrum is in progress.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>FilterCalculation</Text>
        <Enum>7</Enum>
        <Comment>Calculation of estimated load filter.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>FrictionCompensationCalculation</Text>
        <Enum>8</Enum>
        <Comment>Calculation of estimated friction compensation.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>FeedForwardCalculation</Text>
        <Enum>9</Enum>
        <Comment>Calculation of estimated feed forward (KpAccFFT).</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>FrictionCompensationCalculationError</Text>
        <Enum>10</Enum>
        <Comment>Error in the friction calculation, not enough velocity reached.</Comment>
      </EnumInfo>
      <EnumInfo>
        <Text>Finished</Text>
        <Enum>11</Enum>
        <Comment>All measures and calculations done.</Comment>
      </EnumInfo>
      <Properties>
        <Property>
          <Name>plcAttribute_qualified_only</Name>
        </Property>
      </Properties>
