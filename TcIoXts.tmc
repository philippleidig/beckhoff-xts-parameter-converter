          <BaseType GUID="{18071995-0000-0000-0000-00000000000d}">REAL</BaseType>
          <Unit>°C</Unit>
          <PTCID>#x030802C7</PTCID>
          <ContextId>1</ContextId>
        </Parameter>
        <Parameter HideParameter="true" ReadOnly="true" OnlineParameter="true" Group="Drive CoE - Amplifier Settings">
          <Name>TemperatureErrorLevel</Name>
